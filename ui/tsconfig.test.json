{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["vitest/globals", "@testing-library/jest-dom/vitest", "node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["src/shared/*"],
      "@feature/*": ["src/feature/*"],
      "@lib/*": ["src/lib/*"],
      "@api/*": ["src/api/*"],
      "@tests/*": ["tests/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/unit/**/*.ts",
    "tests/unit/**/*.tsx",
    "tests/fixtures/**/*.ts",
    "tests/utils/**/*.ts",
    "tests/utils/**/*.tsx",
    "tests/setup/**/*.ts",
    "tests/setup/**/*.d.ts",
    "test/**/*.ts"
  ]
}
